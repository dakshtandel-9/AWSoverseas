# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Customer email/password sign-in (no extra env vars needed here, but one
# one-time step in the dashboard):
# Supabase -> Authentication -> URL Configuration: set Site URL to
# https://awsoverseas.com and add these Redirect URLs (confirmation and
# password-reset emails link here — they break if the domain is missing):
#   http://localhost:3000/auth/callback
#   https://awsoverseas.com/auth/callback
# "Confirm email" under Authentication -> Sign In / Providers -> Email should
# stay ON so signups must click the confirmation link before they can sign in.

# Transactional email — the registration confirmation (sent when a customer
# submits their profile and ID for verification) and the approval notice
# (sent when an admin approves them at /admin/users).
#
# Resend is the only transport. The Hostinger SMTP path was removed on
# 2026-08-17: its outbound relay, MailChannels, rejects every external
# recipient with `550 5.7.1 [PSFD] Blocked` while still reporting the send as
# queued, and it refuses to send as sales@ while signed in as admin@. Hostinger
# still owns MX and the mailboxes, so replies to the From address below land
# there as normal — only sending moved.
#
# awsoverseas.com is verified in Resend (Tokyo region). Its DKIM/SPF/MX sit on
# resend._domainkey and the send.* subdomain, leaving the root's Hostinger
# records untouched. Get the key from resend.com -> API Keys.
RESEND_API_KEY=
EMAIL_FROM=AWS OVERSEAS impex <admin@awsoverseas.com>
# Sender for enquiry acknowledgements. Any address on the verified domain
# sends fine, but customers reply to it — sales@ must exist as a real Hostinger
# mailbox or those replies bounce. Unset, enquiries fall back to EMAIL_FROM.
EMAIL_FROM_SALES=AWS OVERSEAS impex <sales@awsoverseas.com>
# Any other mailboxes the panel may send as, one per line or comma-separated.
# EMAIL_FROM, EMAIL_FROM_SALES and these are the whole From dropdown at
# /admin/email, and the panel refuses to send as anything outside that list —
# Resend would happily accept any address on the verified domain, so the list
# is what stops the compose box being a way to send as any name at
# awsoverseas.com. Same rule as sales@: a real Hostinger mailbox has to exist
# behind each one, because that's where Reply goes.
#   EMAIL_FROM_EXTRA=AWS OVERSEAS impex <info@awsoverseas.com>
EMAIL_FROM_EXTRA=
# Only needed if EMAIL_FROM is ever moved to an address that can't receive
# mail. Sending as the real mailbox means replies already land in the inbox.
EMAIL_REPLY_TO=
# Where "a new enquiry just came in" alerts go. Unset, they go to EMAIL_FROM's
# address, which is a real mailbox — so the team is notified either way. Set it
# to route alerts to a shared inbox instead.
EMAIL_ADMIN_NOTIFY=

# Admin login
ADMIN_PASSWORD=123456789
# Long random string used to sign the admin session cookie — generate with
# `openssl rand -hex 32`. Do NOT reuse ADMIN_PASSWORD here.
SESSION_SECRET=

# Cloudflare R2 — serves every public media file (product/category photos,
# city agent tiles, enquiry attachments, hero videos). Supabase above stays the
# database only. R2 bills nothing for egress, which is what makes it cheap here.
#
# Where to find these: Cloudflare dashboard -> R2. The account ID is on the R2
# overview page; the key pair comes from "Manage R2 API Tokens" (Object Read &
# Write, scoped to this bucket). R2_PUBLIC_URL is the bucket's Public
# Development URL (Settings -> Public access), or a custom domain once the
# site's DNS moves to Cloudflare.
#
# Leave these blank and uploads fall back to Supabase storage automatically.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=awsoverseas-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Cloudinary — Dashboard home page (cloud name), Settings -> Access Keys (API key/secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDINARY_API_KEY =

CLOUDINARY_API_SECRET =